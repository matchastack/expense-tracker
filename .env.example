# Postgres connection string (e.g. the pooled connection string from Neon).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The password you type once on each device to open the app.
# Required in production. Leave unset in local development to skip sign-in.
APP_PASSWORD=

# Optional. Signs the session cookie; defaults to a key derived from APP_PASSWORD.
# SESSION_SECRET=
